GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
FLASK_SECRET_KEY=change-me-in-production
ADMIN_EMAIL=admin@databiqs.com
ADMIN_PASSWORD=DatabiqsAdmin2026!
# Must match between login and save. Use the dev default locally unless Railway sets its own.
ADMIN_JWT_SECRET=databiqs-admin-dev-secret-change-in-production
# CMS JSON path (default: ./content-store.json in this repo)
# CONTENT_FILE=

# On Vercel, /tmp is wiped per-instance so admin saves don't persist on their
# own. Set these to have every save also commit content-store.json to GitHub,
# and have a cold instance read the latest commit back instead of the stale
# bundled default. Generate a fine-grained GitHub token scoped to just this
# repo with "Contents: Read and write" permission.
# GITHUB_CONTENT_TOKEN=
# GITHUB_CONTENT_REPO=JAFFARDEV12/databiqs-website-backend
# GITHUB_CONTENT_BRANCH=new-design
# GITHUB_CONTENT_PATH=content-store.json
